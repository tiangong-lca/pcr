  "source_records": [
    {
      "id": "hartl-indigo-2024",
      "type": "literature",
      "reference": "Hartl, A.; Polleichtner, A.; Novak, J. (2024). “Purplish Blue” or “Greenish Grey”? Indigo Qualities and Extraction Yields from Six Species. Plants 13(7), 918. https://doi.org/10.3390/plants13070918 ; sections 1, 3, 4.1.3 and 4.3",
      "used_for": "Whole natural pigment, counterevidence on lime dilution, lime-free aqueous/aeration and recovery states; multi-species case conditions are not default yield, recipe or industrial activity"
    },
    {
      "id": "dutta-indigo-2017",
      "type": "literature",
      "reference": "Dutta, S.; Roychoudhary, S.; Sarangi, B.K. (2017). Effect of different physico-chemical parameters for natural indigo production during fermentation of Indigofera plant biomass. 3 Biotech 7, 322. https://doi.org/10.1007/s13205-017-0923-2 ; Introduction; Materials and methods; Results and discussion",
      "used_for": "Indigofera precursor hydrolysis/oxidation species, solid recovery/drying and distinction between crude product and analytical constituent; analytical DMSO is not a manufacturing solvent; no experimental temperature/yield/water-ratio default"
    },
    {
      "id": "eu-cww-2016",
      "type": "official_guidance",
      "reference": "European Commission JRC (2016). Best Available Techniques Reference Document for Common Waste Water and Waste Gas Treatment/Management Systems in the Chemical Sector. JRC103096, BAT 2, printed p.543 (PDF p.573). https://publications.jrc.ec.europa.eu/repository/bitstream/JRC103096/jrc103096_cww_bref_10_2016.pdf",
      "used_for": "Independent process/reaction and wastewater/waste-gas inventory method; no legal applicability claim, pigment emission factor or mandatory treatment efficiency"
    },
    {
      "id": "eu-pef-2021",
      "type": "official_guidance",
      "reference": "European Commission Recommendation (EU) 2021/2279, Annex I, section 4.5, printed/PDF pp.63–64. https://environment.ec.europa.eu/system/files/2021-12/Annexes%201%20to%202.pdf",
      "used_for": "General multifunctionality hierarchy for subdivision, system expansion and justified allocation; no full-PEF claim, fixed coproduct share or automatic substitution credit"
    },
    {
      "id": "teanglum-indigo-wash-2012",
      "type": "literature",
      "reference": "Teanglum, A.; Teanglum, S.; Saithong, A. (2012). Selection of Indigo Plant Varieties and Other Plants that Yield Indigo Dye. Procedia Engineering 32, 184–190. https://doi.org/10.1016/j.proeng.2012.01.1255 ; original sections 1 and 2.2, printed pp.184–185 (PDF pp.1–2), with section 2.3 as separate plant controls",
      "used_for": "Laboratory four-variety Indigofera tinctoria aliquot/yield-isolation method: remove leaves, filter an oxidised-liquor aliquot, water-wash its recovered pigment residue and heat to constant dry mass; not a leaf wash or industrial manufacturing qualification. Other-species controls, inconsistent abstract/body yields, wash count, temperature/time and laboratory filter medium are not industrial recipes, purity proof or energy defaults"
    }
  ],
