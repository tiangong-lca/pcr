      "packages/pcr-docs/scripts/search-layout.ts": "7f84fbe7a052fcfdf3a8ea50a0609cc5fcc6e3c4e46e853e0b6b17f4a6b9264f",
      "packages/pcr-docs/scripts/search-pack-worker.test.ts": "fdaa4d1f2c63abbbc72a6f3a8dfe9acd79b64d3a0e2512857d771526c85d2a25",
      "packages/pcr-docs/scripts/search-v5-corpus-audit.ts": "819b2152ac1ff949bb5b8eb39d99f87743d82b3032839ab7802ddea0f84aac60",
