    "id": "nox_compatibility",
    "before": {
      "id": "nox_compatibility",
      "applies_to": "dryer_nox, handling_nox, boiler_nox",
      "rule": "Compare monitoring, LCI and selected LCIA-mapping NOx mass definitions and NO/NO2 coverage. Generate an aggregate quantity using cp_air only when all three share the same basis; infer neither NO2-equivalent mass nor NO/NO2 ratio, exclude N2O and avoid speciated duplicates. Otherwise quantity remains pending.",
      "inputs": [
        "monitoring mass definition",
        "flow mass definition",
        "LCIA mapping",
        "cp_air",
        "cp_air_utilities"
      ],
      "output": "compatible NOx quantity or explicit pending result",
      "source_ids": [
        "epa-mdf-2002",
        "epa-wood-boiler-2022"
      ]
    },
    "after": {
      "id": "nox_compatibility",
      "applies_to": "dryer_nox, handling_nox, boiler_nox",
      "rule": "Compare monitoring, LCI and selected LCIA-mapping NOx mass definitions and NO/NO2 coverage. Generate an aggregate quantity using the actual emitting source’s owning protocol, cp_air for mdf_line dryer/handling sources or cp_air_utilities for utilities/boiler sources, only when all three share the same basis; infer neither NO2-equivalent mass nor NO/NO2 ratio, exclude N2O and avoid speciated duplicates. Otherwise quantity remains pending.",
