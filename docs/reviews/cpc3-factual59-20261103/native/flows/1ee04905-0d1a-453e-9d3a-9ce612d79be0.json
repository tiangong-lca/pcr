      "common:synonyms": [
        {
          "#text": "Cleaning agents; Hard-surface cleaners; Detergents; Surfactants",
          "@xml:lang": "en"
        },
        {
          "#text": "清洗剂；硬表面清洁剂；洗涤剂；表面活性剂",
          "@xml:lang": "zh"
        }
      ],
      "common:generalComment": [
        {
          "#text": "Cleaning agents or hard-surface cleaners are substances used to remove dirt, including dust, stains, foul odors, and clutter on surfaces. They are usually in the form of liquids, powders, sprays, or granules. Their purposes include health, beauty, removing offensive odor, and avoiding the spread of dirt and contaminants. Surfactants are one of the major components of laundry and cleaning products. They work by lifting dirt and oils off the fabric and attaching it to the water, so the dirt gets rinsed away.",
          "@xml:lang": "en"
        },
        {
          "#text": "清洁剂或硬表面清洁剂是用来清除污垢（包括灰尘、污渍、臭味和表面杂物）的物质。它们通常呈液体、粉末、喷雾或颗粒状。它们的作用包括保健、美容、去除异味以及避免污垢和污染物扩散。表面活性剂是洗衣和清洁产品的主要成分之一。它们的作用是将织物上的污垢和油脂吸附到水中，从而将污垢冲洗干净。",
          "@xml:lang": "zh"
        }
      ],
