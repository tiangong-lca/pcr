      "common:synonyms": [
        {
          "#text": "岩棉；石棉状矿物棉；矿物棉保温材料",
          "@xml:lang": "zh"
        },
        {
          "#text": "rock wool; stone wool; mineral-wool insulation",
          "@xml:lang": "en"
