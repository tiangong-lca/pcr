        "required_qualifiers": [
          "six-string non-electronic configuration and unique instrument/lot identity",
          "solid Adirondack spruce soundboard and solid Indian rosewood back/sides with actual species and origin",
          "mahogany neck and ebony fingerboard/bridge with actual supplied machining state",
          "actual complete bracing/lining/block/binding/purfling/bridge-pin/pickguard/fixing BOM",
          "bone nut/saddle and real adjustment scope",
          "each actual string position/gauge/material and mechanical tuner identity",
          "actual neck joint and any separate bolts/inserts",
          "actual adhesive system with joint/specification permission",
          "actual nitrocellulose body and polyurethane neck coating system and supplied whole preparations",
          "actual wood moisture/conditioning state and same-configuration measured net instrument mass",
          "calibration and first-release functional/sound/playability/appearance acceptance record",
          "actual factory geography period and unique first-release Q",
          "raw/WIP stocks and each inherited flow vector",
          "original FG cohort Q_H and observed service horizon H",
          "gross G/R and original shipment plus actual postwork permission/tests/disposition",
          "per-article six packaging legs and whole/component disjoint bridge",
          "actual utilities/carrier thermal state/returns and supplier water-energy ownership",
          "independent physical mass/element/carbon/water and species-specific emission constraints",
          "independent supplied case/wrench/documents excluded from net guitar mass but accounted once"
        ]
      }
