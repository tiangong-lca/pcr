        "required_qualifiers": [
          "source manufacturer and trim-generation operation",
          "black non-hard vulcanized EPDM compound identity",
          "polymer and cure system with supplier formulation evidence",
          "carbon black filler oil and additive subledger within whole scrap",
          "non-tyre pre-consumer source segregation",
          "actual traceable source condition and legal waste or product state",
          "mechanical grinding and micronizing configuration without intentional devulcanization",
          "one measured powder particle-size distribution and receiver limits",
          "measured retained moisture and dry solids",
          "contamination and actual intended-use acceptance tests",
          "no added coating binder or flow-aid assumption",
          "first-release lot register and original cohort Qc",
          "gross tare and net weighing with uncertainty",
          "opening and closing WIP exchange vectors",
          "opening and closing FG original Qc and burden vectors",
          "all failed and zero-output activity with actual rework genealogy",
          "actual service horizon H and unobserved future scope",
          "gross physical dispatch V and shipment reversals",
          "separate six-leg ledger for every packaging construction",
          "actual voltage country and supplier boundaries",
          "source history and attributional recycling decision",
          "separate capture disposal and final species releases",
          "independently measured water and whole-compound mass balances",
          "all native flow restrictions and provider compatibility"
        ]
      }
