{
  "name": "@tiangong-lca/pcr-library",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "init": "node builder/cli/index.ts init",
    "lint": "npm run vocab:check && npm run aliases:check && npm run catalog:check && npm run cpc-chains:check && node builder/cli/index.ts lint --report .reports/pcr-lint.json",
    "test": "node scripts/engineering/suites.ts run all",
    "validate": "npm run runtime:check && npm run migration:check && npm run typecheck:all && npm run lint && npm test",
    "vocab:generate": "node builder/scripts/generate-controlled-vocabulary.ts",
    "vocab:check": "node builder/scripts/generate-controlled-vocabulary.ts --check",
    "aliases:build": "node builder/scripts/build-pcr-id-aliases.ts",
    "aliases:check": "node builder/scripts/build-pcr-id-aliases.ts --check",
    "catalog:build": "node builder/scripts/build-catalog.ts",
    "catalog:check": "node builder/scripts/build-catalog.ts --check",
    "catalog:recover": "node builder/scripts/build-catalog.ts --recover",
    "cpc-chains:build": "node builder/scripts/render-cpc-product-chain.ts",
    "cpc-chains:check": "node builder/scripts/render-cpc-product-chain.ts --check",
    "goal:doctor": "node builder/cli/goal.ts doctor",
    "goal:plan": "node builder/cli/goal.ts plan",
    "goal:start": "node builder/cli/goal.ts start",
    "goal:status": "node builder/cli/goal.ts status",
    "goal:resume": "node builder/cli/goal.ts resume",
    "goal:integrate": "node builder/cli/goal.ts integrate",
    "goal:land": "node builder/cli/goal.ts land",
    "goal:viewer-publish": "node builder/cli/goal.ts viewer-publish",
    "goal:viewer-recover": "node builder/cli/goal.ts viewer-recover",
    "goal:stop": "node builder/cli/goal.ts stop",
    "goal:uuid-search": "node builder/cli/goal-uuid-search.ts",
    "goal:uuid-audit": "node builder/cli/goal.ts uuid-audit",
    "pcr:materials": "node builder/cli/materials.ts",
    "pcr:import:cpc": "node builder/cli/index.ts import-cpc",
    "pcr:scaffold:cpc": "node builder/scripts/scaffold-leaf-pcrs.ts",
    "pcr:sync-structured": "node builder/cli/index.ts sync-structured",
    "pcr:lifecycle": "node builder/cli/index.ts lifecycle",
    "pcr:bump": "node builder/cli/index.ts bump",
    "pcr:revise": "node builder/cli/index.ts revise",
    "pcr:publish": "node builder/cli/index.ts publish",
    "pcr:recover": "node builder/cli/index.ts recover",
    "tiangong-pcr": "node packages/tiangong-pcr-cli/bin/tiangong-pcr.ts",
    "viewer:build": "node packages/pcr-viewer/scripts/build-viewer-data.ts build",
    "viewer:update": "node packages/pcr-viewer/scripts/build-viewer-data.ts update",
    "viewer:check": "node packages/pcr-viewer/scripts/build-viewer-data.ts check",
    "viewer:recover": "node packages/pcr-viewer/scripts/build-viewer-data.ts recover",
    "viewer:serve": "node packages/pcr-viewer/scripts/serve-viewer.ts",
    "pcr:check": "node builder/cli/index.ts check",
    "goal:prepare-report": "node builder/cli/goal-prepare-report.ts",
    "docs:build": "npm --prefix packages/pcr-docs run build",
    "docs:dev": "npm --prefix packages/pcr-docs run dev",
    "docs:verify": "npm --prefix packages/pcr-docs run verify",
    "offline:library": "node builder/scripts/build-offline-library.ts",
    "offline:tool": "node builder/scripts/build-offline-packages.ts",
    "offline:test": "node --test packages/pcr-core/offline-library.test.ts",
    "release:build": "node builder/scripts/npm-release.ts build",
    "release:test": "node --test builder/scripts/npm-release.test.ts",
    "product:build": "node builder/scripts/product-release.ts build",
    "product:verify": "node builder/scripts/product-release.ts verify",
    "product:publish": "node builder/scripts/product-publish.ts",
    "product:test": "node --test builder/scripts/product-*.test.ts",
    "runtime:check": "node scripts/engineering/runtime.ts",
    "runtime:release": "node scripts/engineering/runtime.ts --release",
    "migration:check": "node scripts/engineering/migration.ts",
    "typecheck": "node scripts/engineering/typecheck.ts --node && node scripts/engineering/typecheck.ts --web",
    "typecheck:all": "node scripts/engineering/typecheck.ts --all",
    "build:engineering": "tsc -p tsconfig.build.json",
    "build:tests": "tsc -p tsconfig.test.json && node scripts/engineering/emitted-assets.ts",
    "test:list": "node scripts/engineering/suites.ts list --json",
    "test:unit": "node scripts/engineering/suites.ts run unit",
    "test:contracts": "node scripts/engineering/suites.ts run contracts",
    "test:integration": "node scripts/engineering/suites.ts run integration",
    "test:recovery": "node scripts/engineering/suites.ts run recovery",
    "test:docs": "node scripts/engineering/suites.ts run docs",
    "test:offline": "node scripts/engineering/suites.ts run offline",
    "test:product": "node scripts/engineering/suites.ts run product",
    "test:engineering": "node scripts/engineering/suites.ts run engineering",
    "test:coverage": "node scripts/engineering/coverage.ts collect .reports/coverage/tests -- node scripts/engineering/suites.ts run all && node scripts/engineering/coverage.ts collect .reports/coverage/docs -- npm run docs:build && node scripts/engineering/coverage.ts report .reports/coverage/report .reports/coverage/tests .reports/coverage/docs",
    "build:runtime": "tsc -p tsconfig.runtime.json",
    "test:browser": "node scripts/engineering/suites.ts run browser",
    "browser:install": "playwright install chromium firefox webkit",
    "typecheck:node": "node scripts/engineering/typecheck.ts --node",
    "docs:browser": "node scripts/engineering/site-browser.ts",
    "qualify:sealed": "node scripts/engineering/sealed-artifact.ts",
    "qualify:web": "node scripts/engineering/sealed-web.ts",
    "test:engineering:compiled": "npm run build:tests && node scripts/engineering/suites.ts run-emitted engineering",
    "coverage:collect": "node scripts/engineering/coverage.ts collect",
    "coverage:report": "node scripts/engineering/coverage.ts report",
    "coverage:inspect": "node scripts/engineering/coverage.ts inspect",
    "test:offline:portable": "node scripts/engineering/suites.ts run portable-offline"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "unified": "11.0.5",
    "yaml": "2.9.1"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/mdast": "4.0.4",
    "@types/node": "26.6.5",
    "c8": "12.0.0",
    "playwright": "1.64.1",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "packageManager": "npm@12.2.0"
}
